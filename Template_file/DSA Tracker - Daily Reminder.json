    {
      "parameters": {
        "jsCode": "const START_DATE = '2026-06-30';\nconst today = new Date();\ntoday.setHours(0, 0, 0, 0);\nconst formatDate = (d) => d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');\nconst todayStr = formatDate(today);\nconst startDate = new Date(START_DATE + 'T00:00:00');\nconst dayNumber = Math.max(1, Math.round((today - startDate) / 86400000) + 1);\n\nconst questions = $('Read Questions').all().map(i => i.json);\nconst totalSolved = questions.filter(q => q.Status !== 'Dropped').length;\nconst targetPace = Math.round(dayNumber / 180 * 300);\nconst diff = totalSolved - targetPace;\nconst paceStr = diff >= 0\n  ? '\\u2705 ahead by ' + diff\n  : '\\u26a0\\ufe0f behind by ' + Math.abs(diff);\n\nconst dueReviews = questions.filter(q =>\n  q.Status === 'Active' && q.NextReviewDate && q.NextReviewDate <= todayStr\n);\n\nlet reviewList;\nif (dueReviews.length === 0) {\n  reviewList = '\\u2022 None \\u2014 clean slate \\ud83c\\udf89';\n} else {\n  reviewList = dueReviews.map(q => '\\u2022 ' + q.Problem + ' (Stage ' + q.Stage + ')').join('\\n');\n}\n\nconst message = '\\ud83d\\udcc5 Day ' + dayNumber + ' / 180\\n'\n  + 'Total solved: ' + totalSolved + '/300 (target pace: ' + targetPace + ') ' + paceStr + '\\n\\n'\n  + 'Due for review today:\\n'\n  + reviewList + '\\n\\n'\n  + 'Go solve in ChatGPT, then /done when ready.';\n\nreturn [{ json: { message: message } }];"
      },
