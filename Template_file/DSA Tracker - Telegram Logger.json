        "jsCode": "const msg = $input.first().json;\nconst raw = msg.message.text || '';\nconst chatId = msg.message.chat.id;\nconst content = raw.replace(/^\\/done\\s*/i, '').trim();\n\nconst prompt = 'You extract structured data from a casual DSA practice log message. The user does not follow a strict format. Return ONLY valid JSON, no markdown fences, no preamble.\\n\\nSchema:\\n{\\n  \"problem\": string,\\n  \"type\": \"New\" | \"Review\",\\n  \"timeTakenMin\": number,\\n  \"confidence\": number (1-5),\\n  \"summary\": string (one line: pattern/approach used),\\n  \"mistake\": string (empty string if none mentioned),\\n  \"link\": string (empty string if none provided)\\n}\\n\\nIf type is not explicitly stated, infer \"New\" unless the message implies this is a repeat/review.\\nIf confidence is not stated, default to 3.\\nIf time is not stated, default to 0.\\n\\nMessage:\\n\"\"\"\\n' + content + '\\n\"\"\"';\n\nconst geminiBody = {\n  contents: [\n    {\n      parts: [\n        {\n          text: prompt\n        }\n      ]\n    }\n  ],\n  generationConfig: {\n    responseMimeType: 'application/json'\n  }\n};\n\nreturn [{ json: { rawMessage: raw, chatId, prompt, geminiBody } }];"
