        "jsCode": "const START_DATE = '2026-06-30';\nconst today = new Date();\ntoday.setHours(0, 0, 0, 0);\nconst formatDate = (d) => d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');\nconst todayStr = formatDate(today);\nconst startDate = new Date(START_DATE + 'T00:00:00');\nconst dayNumber = Math.max(1, Math.round((today - startDate) / 86400000) + 1);\nconst chatId = $('Telegram Trigger1').item.json.message.chat.id;\nreturn [{ json: {\n  Date: todayStr, DayNumber: dayNumber, Logged: 'Y',\n  NewCount: 0, ReviewCount: 0,\n  _chatId: chatId, _dayNumber: dayNumber\n} }];"
      },
