        "jsCode": "const sr = $('Spaced Rep Logic1').item.json;\nconst allDays = $('Read Days1').all().map(i => i.json);\nconst todayStr = sr._todayStr;\nconst existing = allDays.find(d => d.Date === todayStr);\nlet newCount = existing ? (parseInt(existing.NewCount) || 0) : 0;\nlet reviewCount = existing ? (parseInt(existing.ReviewCount) || 0) : 0;\nif (sr._type === 'New') {\n  newCount++;\n} else {\n  reviewCount++;\n}\nreturn [{ json: {\n  Date: todayStr,\n  DayNumber: sr._dayNumber,\n  Logged: 'Y',\n  NewCount: newCount,\n  ReviewCount: reviewCount\n} }];"
