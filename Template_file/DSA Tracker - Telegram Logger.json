    {
      "parameters": {
        "jsCode": "const INTERVALS = [1, 3, 7, 14, 30, 60];\nconst START_DATE = '2026-06-30';\n\nconst parsed = $('Validate Response1').item.json;\nconst questions = $('Read Questions1').all().map(i => i.json);\nconst rawMessage = $('Extract Message1').item.json.rawMessage;\nconst chatId = $('Extract Message1').item.json.chatId;\n\nconst today = new Date();\ntoday.setHours(0, 0, 0, 0);\nconst formatDate = (d) => d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');\nconst todayStr = formatDate(today);\nconst startDate = new Date(START_DATE + 'T00:00:00');\nconst dayNumber = Math.max(1, Math.round((today - startDate) / 86400000) + 1);\n\nconst existing = questions.find(q =>\n  q.Problem && q.Problem.toLowerCase().trim() === parsed.problem.toLowerCase().trim()\n);\n\nlet type = parsed.type;\nlet stage, nextReviewDate, status, id, dateAdded, link, topic, pattern, difficulty;\n\nif (existing) {\n  if (type === 'New') type = 'Review';\n  stage = parseInt(existing.Stage) || 0;\n  const conf = parsed.confidence;\n  if (conf <= 2) {\n    stage = 0;\n  } else if (conf === 3) {\n    stage = Math.min(stage + 1, INTERVALS.length - 1);\n  } else {\n    stage = Math.min(stage + 2, INTERVALS.length - 1);\n  }\n  const nrd = new Date(today);\n  nrd.setDate(nrd.getDate() + INTERVALS[stage]);\n  const formatDate = (d) => d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');\n  nextReviewDate = formatDate(nrd);\n  status = existing.Status || 'Active';\n  if (stage >= INTERVALS.length - 1 && conf >= 4) {\n    status = 'Mastered';\n  }\n  id = existing.ID;\n  dateAdded = existing.DateAdded;\n  link = parsed.link || existing.Link || '';\n  topic = existing.Topic || '';\n  pattern = parsed.summary || existing.Pattern || '';\n  difficulty = existing.Difficulty || '';\n} else {\n  type = 'New';\n  id = Date.now().toString(36);\n  stage = 0;\n  const nrd = new Date(today);\n  nrd.setDate(nrd.getDate() + INTERVALS[0]);\n  const formatDate = (d) => d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');\n  nextReviewDate = formatDate(nrd);\n  status = 'Active';\n  dateAdded = todayStr;\n  link = parsed.link || '';\n  topic = '';\n  pattern = parsed.summary || '';\n  difficulty = '';\n}\n\nreturn [{ json: {\n  ID: id, Problem: parsed.problem.trim(), Link: link, Topic: topic,\n  Pattern: pattern, Difficulty: difficulty, DateAdded: dateAdded,\n  Status: status, Stage: stage, NextReviewDate: nextReviewDate,\n  LastConfidence: parsed.confidence,\n  _type: type, _dayNumber: dayNumber, _timeTakenMin: parsed.timeTakenMin,\n  _summary: parsed.summary, _mistake: parsed.mistake,\n  _rawMessage: rawMessage, _chatId: chatId, _todayStr: todayStr\n} }];"
      },
